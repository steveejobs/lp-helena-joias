NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_STORE_SLUG=helena-joias

# Public Supabase values. The publishable key is safe for browser authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional JSON map used before the slug fallback.
# Example: {"www.helenajoias.com.br":"helena-joias"}
STORE_DOMAIN_MAP={}

# Optional. Comma-separated emails allowed to reach Helena admin after Auth.
HELENA_ADMIN_EMAILS=

# Optional analytics destinations. GA4 uses the same canonical event layer.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional map tile provider. Keep {z}/{x}/{y} placeholders.
# The OpenStreetMap default is used when omitted.
NEXT_PUBLIC_ANALYTICS_TILE_URL=
